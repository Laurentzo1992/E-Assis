EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
QDRANT_COLLECTION=kbbot_documents
OCR_MIN_CHARS=50
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150

# Image Docker utilisee par Airflow pour extract_structured_data/match_and_alert (cf.
# dags/dag_kbbot_quotidien.py). A laisser absent en dev (repli automatique sur "kbbot-ingest:local",
# construit localement) - a definir explicitement en prod sur le VPS :
# INGEST_IMAGE=ghcr.io/laurentzo1992/kbbot-ingest:latest
# INGEST_IMAGE=kbbot-ingest:local

MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=kbbot
# Hote resolvable depuis le navigateur pour les URL de telechargement de PDF presignees
# (api/minio_client.py) - en prod, remplacer par le domaine public (routee vers minio:9000 par le
# reverse-proxy, cf. Caddyfile) et passer MINIO_PUBLIC_SECURE=true, sinon les URL presignees
# restent en http:// et sont bloquees en mixed-content par le navigateur depuis une page HTTPS.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false

DGCMEF_TAXONOMY_URL=https://www.dgcmef.gov.bf/fr/taxonomy/term/16

AIRFLOW_DB_USER=changeme
AIRFLOW_DB_PASSWORD=changeme
AIRFLOW_DB_NAME=airflow_metadata
AIRFLOW_ADMIN_USER=changeme
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_EMAIL=changeme@example.com
# Generer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme
AIRFLOW_SECRET_KEY=changeme
# Optionnel - notification d'echec de DAG sur Slack (dags/notifications.py)
SLACK_WEBHOOK_URL=

# --- Backend FastAPI "entreprises" (api/, integre depuis E-Assis, remplace Django) ---
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme

# Generer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme
# Site d'administration (sqladmin, /admin - voir api/admin.py) : cle de signature de la session de
# connexion admin, distincte de JWT_SECRET_KEY. Optionnelle - retombe sur JWT_SECRET_KEY si vide,
# mais definir une valeur propre en production (les deux ne devraient pas partager la meme cle).
ADMIN_SESSION_SECRET_KEY=changeme
DEFAULT_FROM_EMAIL=changeme@example.com
FRONTEND_DOMAIN=http://localhost:3000
# Domaine public de l'API elle-meme (distinct de FRONTEND_DOMAIN) - utilise pour le webhook
# CinetPay (notify_url), qui doit joindre l'API, pas le frontend. Exige une URL HTTPS publique en
# production - inutilisable en local (voir api/payment_client.py).
API_PUBLIC_DOMAIN=http://localhost:8000

# SMTP - un mot de passe d'application (pas le mot de passe du compte) est requis pour Gmail
EMAIL_HOST_USER=changeme
EMAIL_HOST_PASSWORD=changeme

GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme

# --- LLM (llm_service) - 100% local via Ollama. Voir llm_client.py.
OLLAMA_HOST=http://ollama:11434

# --- Alertes WhatsApp (Meta Cloud API) - WHATSAPP_TEMPLATE_NAME doit correspondre a un modele
# deja approuve par Meta (3 variables dans l'ordre : nom entreprise, resume LLM, organisme).
WHATSAPP_TOKEN=changeme
WHATSAPP_PHONE_NUMBER_ID=changeme
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=nouvelle_opportunite_marche
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_DEFAULT_COUNTRY_CODE=226
WHATSAPP_MIN_MATCH_SCORE=0.35

# --- Abonnement annuel par entreprise (essai gratuit puis payant) - voir api/payment_client.py.
# Prix et duree d'essai geres en base (table tarifs_abonnement, cf. api/models/tarif.py) plutot
# qu'ici, modifiables depuis /admin sans redeploiement. Fournisseur CinetPay (Mobile Money Orange/
# Moov + carte) - voir https://cinetpay.com. Aucun compte reel a ce stade : integration ecrite et
# testee via mocks uniquement, jamais verifiee contre l'API CinetPay reelle (necessite un
# hebergement public pour le webhook, cf. API_PUBLIC_DOMAIN).
CINETPAY_API_KEY=changeme
CINETPAY_SITE_ID=changeme
