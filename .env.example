EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
QDRANT_COLLECTION=kbbot_documents
OCR_MIN_CHARS=50
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=150

MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=kbbot

DGCMEF_TAXONOMY_URL=https://www.dgcmef.gov.bf/fr/taxonomy/term/16

AIRFLOW_DB_USER=changeme
AIRFLOW_DB_PASSWORD=changeme
AIRFLOW_DB_NAME=airflow_metadata
AIRFLOW_ADMIN_USER=changeme
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_EMAIL=changeme@example.com
# Generer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme
AIRFLOW_SECRET_KEY=changeme
# Optionnel - notification d'echec de DAG sur Slack (dags/notifications.py)
SLACK_WEBHOOK_URL=

# --- Backend FastAPI "entreprises" (api/, integre depuis E-Assis, remplace Django) ---
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=changeme

# Generer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme
DEFAULT_FROM_EMAIL=changeme@example.com
FRONTEND_DOMAIN=http://localhost:3000

# SMTP - un mot de passe d'application (pas le mot de passe du compte) est requis pour Gmail
EMAIL_HOST_USER=changeme
EMAIL_HOST_PASSWORD=changeme

GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
