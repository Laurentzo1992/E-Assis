# Build de production (contrairement a Dockerfile, qui lance le serveur de developpement
# npm start pour le hot-reload local) - genere un bundle statique optimise, servi par nginx.
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# REACT_APP_API_URL doit etre connu AU BUILD (Create React App l'inline statiquement dans le
# bundle JS, pas de lecture dynamique cote client) - cf. src/config.js. Passe en argument de build
# (docker compose build --build-arg ou "args:" dans docker-compose.prod.yml), pas en variable
# d'environnement du conteneur final (nginx ne l'utilise jamais).
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL
# CI=true : memes garde-fous qu'en local (warnings ESLint = erreurs de build), pour ne jamais
# deployer un bundle construit a partir d'un etat que le build local aurait refuse.
RUN CI=true npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
