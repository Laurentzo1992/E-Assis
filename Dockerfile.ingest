FROM python:3.11-slim

WORKDIR /app

# torch CPU uniquement : le GPU local est deja reserve par le conteneur vision-ocr, et le volume
# d'embeddings ici (quelques centaines de chunks par bulletin) ne le justifie pas.
RUN pip install --no-cache-dir torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Sans ca, stdout est bufferise par bloc quand il n'est pas attache a un TTY (cas de "docker logs"
# sur un conteneur detache) - les print() de progression de extract_bulletin.py/match_and_alert.py
# n'apparaitraient qu'a la fin du process au lieu d'etre visibles en temps reel.
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "-m"]
